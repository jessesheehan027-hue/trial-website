<script>

/* =========================================
   ALPHA BLADES BOOKING SYSTEM
   =========================================

   Opening hours:
   Mon 08:30 - 18:00
   Tue 08:30 - 18:00
   Wed 08:30 - 18:00
   Thu 08:30 - 20:00
   Fri 08:30 - 18:00
   Sat 08:00 - 18:00
   Sun 09:00 - 16:30

   Appointment start times are every 30 minutes.
*/

const openingHours = {

  0: { start: "09:00", end: "16:30" }, // Sunday
  1: { start: "08:30", end: "18:00" }, // Monday
  2: { start: "08:30", end: "18:00" }, // Tuesday
  3: { start: "08:30", end: "18:00" }, // Wednesday
  4: { start: "08:30", end: "20:00" }, // Thursday
  5: { start: "08:30", end: "18:00" }, // Friday
  6: { start: "08:00", end: "18:00" }  // Saturday

};

const dateInput =
document.getElementById("date");

const serviceInput =
document.getElementById("service");

const timeSlots =
document.getElementById("timeSlots");

const selectedTime =
document.getElementById("selectedTime");

let chosenTime = "";


/* Prevent selecting dates in the past */

const today =
new Date().toISOString().split("T")[0];

dateInput.min = today;


/* Convert HH:MM to minutes */

function timeToMinutes(time){

  const parts = time.split(":");

  return Number(parts[0]) * 60 + Number(parts[1]);

}


/* Convert minutes to HH:MM */

function minutesToTime(minutes){

  const hours =
  Math.floor(minutes / 60);

  const mins =
  minutes % 60;

  return String(hours).padStart(2,"0")
  + ":"
  + String(mins).padStart(2,"0");

}


/* Convert 24 hour time to nicer display */

function displayTime(time){

  let [hours, minutes] =
  time.split(":").map(Number);

  const suffix =
  hours >= 12 ? "PM" : "AM";

  hours =
  hours % 12 || 12;

  return `${hours}:${String(minutes).padStart(2,"0")} ${suffix}`;

}


/* Generate appointment slots */

function generateSlots(){

  timeSlots.innerHTML = "";

  chosenTime = "";

  selectedTime.textContent =
  "No time selected.";

  if(!dateInput.value ||
     !serviceInput.value){

    return;
  }

  const selectedDate =
  new Date(dateInput.value + "T00:00:00");

  const day =
  selectedDate.getDay();

  const hours =
  openingHours[day];

  if(!hours){

    timeSlots.innerHTML =
    "<p>Closed on this day.</p>";

    return;
  }

  const service =
  serviceInput.options[
    serviceInput.selectedIndex
  ];

  const duration =
  Number(service.dataset.duration || 30);

  const start =
  timeToMinutes(hours.start);

  const close =
  timeToMinutes(hours.end);

  /*
    Only show a start time if the entire service
    can fit before closing.
  */

  for(
    let time = start;
    time + duration <= close;
    time += 30
  ){

    const formatted =
    minutesToTime(time);

    const button =
    document.createElement("button");

    button.type = "button";

    button.className =
    "time-slot";

    button.textContent =
    displayTime(formatted);

    button.addEventListener(
      "click",
      function(){

        document
        .querySelectorAll(".time-slot")
        .forEach(btn =>
          btn.classList.remove("selected")
        );

        button.classList.add("selected");

        chosenTime =
        formatted;

        selectedTime.textContent =
        "Selected: " +
        displayTime(formatted) +
        " • " +
        service.value;

      }
    );

    timeSlots.appendChild(button);

  }

}


/* Update times when date changes */

dateInput.addEventListener(
  "change",
  generateSlots
);


/* Update times when service changes */

serviceInput.addEventListener(
  "change",
  generateSlots
);


/* Booking form */

document
.getElementById("bookingForm")
.addEventListener(
  "submit",
  function(event){

    event.preventDefault();

    if(!chosenTime){

      alert(
        "Please choose an appointment time."
      );

      return;
    }

    const name =
    document.getElementById("name").value;

    const phone =
    document.getElementById("phone").value;

    const service =
    serviceInput.value;

    const date =
    dateInput.value;

    const notes =
    document.getElementById("notes").value;

    const selectedOption =
    serviceInput.options[
      serviceInput.selectedIndex
    ];

    const price =
    selectedOption.dataset.price;

    const duration =
    selectedOption.dataset.duration;

    const message =
`Hi ALPHA BLADES Narellan,

I'd like to request an appointment.

Name: ${name}
Phone: ${phone}

Service: ${service}
Estimated price: ${price}
Duration: ${duration} minutes

Date: ${date}
Time: ${displayTime(chosenTime)}

Notes:
${notes}

Please confirm if this appointment is available.`;

    /*
      Australian mobile number in international format.
      This opens the customer's SMS app.
    */

    const smsUrl =
    "sms:+61485522448?body="
    + encodeURIComponent(message);

    window.location.href = smsUrl;

  }
);

</script>

